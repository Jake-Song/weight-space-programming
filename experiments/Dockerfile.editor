FROM python:3.12-slim
RUN pip install --no-cache-dir torch==2.14.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir numpy scipy scikit-learn pandas sympy networkx safetensors tokenizers
COPY experiments /app
WORKDIR /work
ENV HOME=/tmp PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2
ENTRYPOINT ["python", "/app/kernel.py"]

FROM vllm/vllm-openai:v0.33.0
RUN pip install --no-cache-dir transformers==5.20.2 datasets==4.8.5 safetensors==0.8.0 math-verify==0.9.0
COPY experiments /app
COPY results/vendor/code/mathqa.py /app/mathqa.py
ENV HOME=/tmp HF_HOME=/tmp/hf VLLM_CACHE_ROOT=/tmp/vllm PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "/app/worker.py"]
